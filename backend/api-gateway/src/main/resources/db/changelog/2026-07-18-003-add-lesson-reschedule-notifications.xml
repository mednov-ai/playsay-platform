<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-07-18-003-add-lesson-reschedule-notifications" author="codex">
        <addColumn tableName="lesson_email_reminder">
            <column name="previous_scheduled_start" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="previous_scheduled_end" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="scheduled_start_snapshot" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="scheduled_end_snapshot" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>
        <createIndex tableName="lesson_email_reminder" indexName="idx_lesson_email_reminder_type_status">
            <column name="lesson_id"/>
            <column name="reminder_type"/>
            <column name="status"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
