{
  "manifest_version": 3,
  "name": "Play&Say Shared Activities",
  "description": "Shares an external classroom activity with lesson participants after an explicit teacher action.",
  "version": "0.1.5",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "debugger", "storage", "tabCapture", "tabs"],
  "host_permissions": [
    "https://dev.online.honey.school/*",
    "https://online.honey.school/*",
    "https://online.honeyschool.ru/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "icons": {
    "16": "icons/bee-16.png",
    "32": "icons/bee-32.png",
    "48": "icons/bee-48.png",
    "128": "icons/bee-128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Share this activity with Play&Say",
    "default_icon": {
      "16": "icons/bee-16.png",
      "32": "icons/bee-32.png",
      "48": "icons/bee-48.png",
      "128": "icons/bee-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://dev.online.honey.school/*",
        "https://online.honey.school/*",
        "https://online.honeyschool.ru/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ]
}
