<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-08-30-001-add-compact-lesson-access" author="codex">
        <addColumn tableName="lesson_access_link">
            <column name="alias_hash" type="varchar(64)"/>
        </addColumn>
        <addUniqueConstraint
            tableName="lesson_access_link"
            columnNames="alias_hash"
            constraintName="uk_lesson_access_link_alias"/>

        <addColumn tableName="lesson_entry_attempt">
            <column name="request_origin" type="varchar(255)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
