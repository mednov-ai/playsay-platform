<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-07-09-001-add-managed-students" author="codex">
        <addColumn tableName="app_user">
            <column name="managed_by_teacher" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="managed_by_teacher_user_id" type="UUID"/>
        </addColumn>
        <addForeignKeyConstraint
            baseTableName="app_user"
            baseColumnNames="managed_by_teacher_user_id"
            constraintName="fk_app_user_managed_by_teacher"
            referencedTableName="app_user"
            referencedColumnNames="id"
            onDelete="SET NULL"/>
        <createIndex tableName="app_user" indexName="idx_app_user_managed_teacher">
            <column name="managed_by_teacher"/>
            <column name="managed_by_teacher_user_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
