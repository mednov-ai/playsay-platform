<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-09-19-001-vocabulary-rework-archive" author="codex">
        <addColumn tableName="vocabulary_selection_recipes"><column name="archived_at" type="TIMESTAMP WITH TIME ZONE"/></addColumn>
        <addColumn tableName="vocabulary_practice_sessions"><column name="rework_source_session_id" type="UUID"/></addColumn>
