<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-07-14-001-create-user-management" author="codex">
        <addColumn tableName="app_user">
            <column name="roles_changed_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="deleted_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="deleted_by_user_id" type="UUID"/>
        </addColumn>

        <createTable tableName="teacher_delegation">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="primary_teacher_user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="delegate_teacher_user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="starts_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="ends_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="created_by_user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="revoked_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="revoked_by_user_id" type="UUID"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="teacher_delegation" baseColumnNames="primary_teacher_user_id"
            constraintName="fk_teacher_delegation_primary" referencedTableName="app_user" referencedColumnNames="id" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="teacher_delegation" baseColumnNames="delegate_teacher_user_id"
            constraintName="fk_teacher_delegation_delegate" referencedTableName="app_user" referencedColumnNames="id" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="teacher_delegation" baseColumnNames="created_by_user_id"
            constraintName="fk_teacher_delegation_creator" referencedTableName="app_user" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="teacher_delegation" baseColumnNames="revoked_by_user_id"
            constraintName="fk_teacher_delegation_revoker" referencedTableName="app_user" referencedColumnNames="id"/>
        <sql>ALTER TABLE teacher_delegation ADD CONSTRAINT chk_teacher_delegation_period CHECK (starts_at &lt; ends_at)</sql>
        <sql>ALTER TABLE teacher_delegation ADD CONSTRAINT chk_teacher_delegation_distinct_teachers CHECK (primary_teacher_user_id &lt;&gt; delegate_teacher_user_id)</sql>
        <createIndex tableName="teacher_delegation" indexName="idx_teacher_delegation_primary_period">
            <column name="primary_teacher_user_id"/><column name="starts_at"/><column name="ends_at"/>
        </createIndex>
        <createIndex tableName="teacher_delegation" indexName="idx_teacher_delegation_delegate_period">
            <column name="delegate_teacher_user_id"/><column name="starts_at"/><column name="ends_at"/>
        </createIndex>

        <createTable tableName="teacher_delegation_student">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="delegation_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="student_user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="teacher_delegation_student" columnNames="delegation_id,student_user_id"
            constraintName="uq_teacher_delegation_student"/>
        <addForeignKeyConstraint baseTableName="teacher_delegation_student" baseColumnNames="delegation_id"
            constraintName="fk_teacher_delegation_student_delegation" referencedTableName="teacher_delegation" referencedColumnNames="id" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="teacher_delegation_student" baseColumnNames="student_user_id"
            constraintName="fk_teacher_delegation_student_user" referencedTableName="app_user" referencedColumnNames="id" onDelete="CASCADE"/>
        <createIndex tableName="teacher_delegation_student" indexName="idx_teacher_delegation_student_user">
            <column name="student_user_id"/>
        </createIndex>

        <createTable tableName="user_management_audit">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="actor_user_id" type="UUID"><constraints nullable="false"/></column>
            <column name="action" type="VARCHAR(80)"><constraints nullable="false"/></column>
            <column name="target_subject" type="VARCHAR(255)"/>
            <column name="details" type="TEXT"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableName="user_management_audit" baseColumnNames="actor_user_id"
            constraintName="fk_user_management_audit_actor" referencedTableName="app_user" referencedColumnNames="id"/>
        <createIndex tableName="user_management_audit" indexName="idx_user_management_audit_created_at"><column name="created_at"/></createIndex>

        <createTable tableName="user_deletion_operation">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="target_user_id" type="UUID"><constraints nullable="false"/></column>
            <column name="target_subject" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="requested_by_user_id" type="UUID"><constraints nullable="false"/></column>
            <column name="replacement_teacher_user_id" type="UUID"/>
            <column name="status" type="VARCHAR(24)"><constraints nullable="false"/></column>
            <column name="error_code" type="VARCHAR(120)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="completed_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="user_deletion_operation" baseColumnNames="target_user_id"
            constraintName="fk_user_deletion_operation_target" referencedTableName="app_user" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="user_deletion_operation" baseColumnNames="requested_by_user_id"
            constraintName="fk_user_deletion_operation_requester" referencedTableName="app_user" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="user_deletion_operation" baseColumnNames="replacement_teacher_user_id"
            constraintName="fk_user_deletion_operation_replacement" referencedTableName="app_user" referencedColumnNames="id"/>
        <createIndex tableName="user_deletion_operation" indexName="idx_user_deletion_operation_subject"><column name="target_subject"/></createIndex>
    </changeSet>
</databaseChangeLog>
