pipeline {
  agent {
    kubernetes {
      yaml """
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins
  securityContext:
    fsGroup: 1000
    fsGroupChangePolicy: OnRootMismatch
  containers:
    - name: node
      image: node:22
      command: ["cat"]
      tty: true
      resources:
        requests:
          cpu: 100m
          memory: 192Mi
        limits:
          cpu: 500m
          memory: 512Mi
"""
    }
  }

  options {
    buildDiscarder(logRotator(numToKeepStr: '30'))
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
    timestamps()
  }

  parameters {
    string(name: 'BRANCH_NAME', defaultValue: 'develop', description: 'Git branch received from GitHub push event.', trim: true)
    string(name: 'GITHUB_BEFORE', defaultValue: '', description: 'GitHub push before SHA.', trim: true)
    string(name: 'GITHUB_AFTER', defaultValue: '', description: 'GitHub push after SHA.', trim: true)
    string(name: 'FORCE_TARGETS', defaultValue: '', description: 'Optional manual override: all or comma-separated deploy targets.', trim: true)
    string(name: 'MAX_PARALLEL_MODULE_JOBS', defaultValue: '1', description: 'Maximum downstream module jobs to run at once. Dev default is 1 for single-node VPS stability; use 2 only after checking node memory and swap.', trim: true)
  }

  environment {
    PLATFORM_REPO = 'https://github.com/mednov-ai/playsay-platform.git'
  }

  stages {
    stage('Checkout') {
      steps {
        script {
          def requestedBranch = params.BRANCH_NAME?.trim() ?: 'develop'
          def requestedCommit = params.GITHUB_AFTER?.trim()
          def scmVars = checkout([
            $class: 'GitSCM',
            branches: [[name: "*/${requestedBranch}"]],
            doGenerateSubmoduleConfigurations: false,
            extensions: [],
            submoduleCfg: [],
            userRemoteConfigs: [[url: env.PLATFORM_REPO]]
          ])
          if (requestedCommit) {
            sh "git fetch --no-tags origin +refs/heads/${requestedBranch}:refs/remotes/origin/${requestedBranch}"
            sh "git checkout --detach ${requestedCommit}"
          }
          env.CI_BRANCH = requestedBranch.replaceFirst(/^origin\//, '').replaceFirst(/^\*\//, '')
          env.GIT_COMMIT = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
          env.GIT_COMMIT_SHORT = env.GIT_COMMIT.take(12)
          currentBuild.displayName = "dispatch-${env.BUILD_NUMBER}"
          currentBuild.description = "${env.CI_BRANCH} @ ${env.GIT_COMMIT_SHORT}"
          echo "Dispatcher source branch: ${env.CI_BRANCH}"
          echo "Dispatcher source commit: ${env.GIT_COMMIT}"
        }
      }
    }

    stage('Detect affected targets') {
      steps {
        container('node') {
          sh '''
            set -eu
            if ! command -v git >/dev/null 2>&1; then
              if command -v apt-get >/dev/null 2>&1; then
                apt-get update
                apt-get install -y --no-install-recommends git ca-certificates
              elif command -v apk >/dev/null 2>&1; then
                apk add --no-cache git ca-certificates
              else
                echo "git is required for affected-target detection"
                exit 1
              fi
            fi
            git config --global --add safe.directory "$WORKSPACE"
            GITHUB_BEFORE="${GITHUB_BEFORE:-}" \
            GITHUB_AFTER="${GITHUB_AFTER:-}" \
            FORCE_TARGETS="${FORCE_TARGETS:-}" \
              node scripts/ci/detect-affected-targets.mjs > affected-targets.json
            GITHUB_BEFORE="${GITHUB_BEFORE:-}" \
            GITHUB_AFTER="${GITHUB_AFTER:-}" \
            FORCE_TARGETS="${FORCE_TARGETS:-}" \
              node scripts/ci/detect-affected-targets.mjs --env > affected-targets.env
            cat affected-targets.json
            cat affected-targets.env
          '''
        }
      }
    }

    stage('Dispatch downstream jobs') {
      steps {
        script {
          def detection = [:]
          readFile('affected-targets.env').split('\\n').each { line ->
            def separator = line.indexOf('=')
            if (separator >= 0) {
              detection[line.substring(0, separator)] = line.substring(separator + 1).trim()
            }
          }
          def jobs = (detection.AFFECTED_JOBS ?: '').split(',').collect { it.trim() }.findAll { it }
          def maxParallelText = params.MAX_PARALLEL_MODULE_JOBS?.trim() ?: '1'
          if (!(maxParallelText ==~ /[1-9]/)) {
            error "MAX_PARALLEL_MODULE_JOBS must be an integer from 1 to 9; got '${maxParallelText}'"
          }
          def maxParallelModuleJobs = maxParallelText.toInteger()
          echo "Affected targets: ${detection.AFFECTED_TARGETS ?: '(none)'}"
          echo "Detection reason: ${detection.AFFECTED_REASON ?: '(unknown)'}"
          if (jobs.isEmpty()) {
            echo 'No downstream jobs needed for this change.'
            return
          }

          dir('downstream-results') {
            deleteDir()
            writeFile file: '.initialized', text: ''
          }

          def indexedJobs = []
          jobs.eachWithIndex { jobName, index ->
            indexedJobs << [name: jobName, index: index]
          }
          def batches = indexedJobs.collate(maxParallelModuleJobs)
          echo "Dispatching ${jobs.size()} downstream job(s) with max parallelism ${maxParallelModuleJobs}"

          batches.eachWithIndex { batch, batchIndex ->
            echo "Starting downstream batch ${batchIndex + 1}/${batches.size()}: ${batch.collect { it.name }.join(', ')}"
            def branches = [:]
            batch.each { job ->
              def branchJobName = job.name
              def branchResultFile = "downstream-results/${job.index}-${branchJobName.replaceAll(/[^A-Za-z0-9_.-]/, '_')}.properties"
              branches[branchJobName] = {
                def downstreamParams = [
                  string(name: 'BRANCH_NAME', value: env.CI_BRANCH),
                  string(name: 'GITHUB_BEFORE', value: params.GITHUB_BEFORE?.trim() ?: ''),
                  string(name: 'GITHUB_AFTER', value: env.GIT_COMMIT)
                ]
                try {
                  echo "Triggering ${branchJobName}"
                  def downstreamBuild = build job: branchJobName, parameters: downstreamParams, wait: true, propagate: false
                  def downstreamResult = downstreamBuild?.result ?: 'UNKNOWN'
                  def downstreamNumber = downstreamBuild?.number ?: ''
                  def downstreamUrl = downstreamBuild?.absoluteUrl ?: ''
                  echo "${branchJobName} completed with ${downstreamResult}"
                  writeFile file: branchResultFile, text: "job=${branchJobName}\nresult=${downstreamResult}\nnumber=${downstreamNumber}\nurl=${downstreamUrl}\n"
                } catch (err) {
                  def sanitizedError = err.toString().replace('\n', ' ')
                  echo "${branchJobName} dispatch failed: ${sanitizedError}"
                  writeFile file: branchResultFile, text: "job=${branchJobName}\nresult=FAILURE\nnumber=\nurl=\nerror=${sanitizedError}\n"
                }
              }
            }
            parallel branches
          }

          def downstreamResults = indexedJobs.collect { job ->
            def resultFile = "downstream-results/${job.index}-${job.name.replaceAll(/[^A-Za-z0-9_.-]/, '_')}.properties"
            if (!fileExists(resultFile)) {
              [job: job.name, result: 'FAILURE', number: '', url: '', error: 'missing result file']
            } else {
              def values = [:]
              readFile(resultFile).split('\\n').each { line ->
                def separator = line.indexOf('=')
                if (separator > 0) {
                  values[line.substring(0, separator)] = line.substring(separator + 1)
                }
              }
              values
            }
          }
          def resultSummary = downstreamResults.collect { result ->
            def buildRef = result.number ? " #${result.number}" : ''
            "${result.job}=${result.result}${buildRef}"
          }.join(', ')
          echo "Downstream module job results: ${resultSummary}"

          def failures = downstreamResults.findAll { result -> result.result != 'SUCCESS' }
          if (!failures.isEmpty()) {
            def failureSummary = failures.collect { result ->
              def buildRef = result.number ? " #${result.number}" : ''
              "${result.job}=${result.result}${buildRef}"
            }.join(', ')
            error "Downstream module job failures: ${failureSummary}"
          }
        }
      }
    }
  }

  post {
    always {
      echo "Dispatcher ${env.BUILD_NUMBER} finished with ${currentBuild.currentResult}"
    }
  }
}
