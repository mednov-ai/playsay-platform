pipeline {
  agent {
    kubernetes {
      yaml '''
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins
  activeDeadlineSeconds: 3600
  securityContext:
    fsGroup: 1000
  containers:
    - name: jnlp
      image: jenkins/inbound-agent:3383.vc8881d4b_0e76-1-jdk25
      resources:
        requests: { cpu: 50m, memory: 128Mi }
        limits: { cpu: 300m, memory: 384Mi }
    - name: image-security
      image: aquasec/trivy@sha256:790fd66d1697395d8693d1acaa1ea702406a20f109b6fc7bac8db623eca6c06c
      command: ["cat"]
      tty: true
      resources:
        requests: { cpu: 100m, memory: 256Mi }
        limits: { cpu: "1", memory: 1536Mi }
'''
    }
  }
  options {
    skipDefaultCheckout(true)
    timeout(time: 55, unit: 'MINUTES')
  }
  stages {
    stage('Audit immutable images') {
      steps {
        container('image-security') {
          withCredentials([usernamePassword(credentialsId: 'github-ghcr', usernameVariable: 'GHCR_USER', passwordVariable: 'GHCR_TOKEN')]) {
            sh '''
              set -eu
              set +x
              mkdir -p image-security/production-baseline .image-audit-cache
              export TRIVY_USERNAME="$GHCR_USER" TRIVY_PASSWORD="$GHCR_TOKEN"
              trivy --version > image-security/production-baseline/scanner-version.txt
              trivy image --config '' --ignorefile '' --cache-dir .image-audit-cache --no-progress --image-src remote --scanners vuln --pkg-types os,library --list-all-pkgs --format json --output image-security/production-baseline/keycloak-prod.json 'ghcr.io/mednov-ai/playsay-keycloak@sha256:4906970a91906e3b9747f739e94f1495363c410c7bbc59e6090062e6b7c5cc05'
              trivy image --config '' --ignorefile '' --cache-dir .image-audit-cache --skip-db-update --no-progress --image-src remote --scanners vuln --pkg-types os,library --list-all-pkgs --format json --output image-security/production-baseline/keycloak-candidate.json 'ghcr.io/mednov-ai/playsay-keycloak@sha256:f79ab63440522b836f91ecf9ce420709a442d298246c4a5502666753fd9292cf'
              trivy image --config '' --ignorefile '' --cache-dir .image-audit-cache --skip-db-update --no-progress --image-src remote --scanners vuln --pkg-types os,library --list-all-pkgs --format json --output image-security/production-baseline/postgres-prod.json 'ghcr.io/cloudnative-pg/postgresql@sha256:6ae4a22c14bdc66e5feaafd38d12c3956fabf9ce9582189e6aa4ee767d981d1b'
              trivy image --config '' --ignorefile '' --cache-dir .image-audit-cache --skip-db-update --no-progress --image-src remote --scanners vuln --pkg-types os,library --list-all-pkgs --format json --output image-security/production-baseline/postgres-candidate.json 'ghcr.io/cloudnative-pg/postgresql@sha256:03a1c6a62b27e8ad31cae5c085131b5ac706b09403d6fcb6c58d16c8daa257cd'
              unset TRIVY_USERNAME TRIVY_PASSWORD
              trivy image --config '' --ignorefile '' --cache-dir .image-audit-cache --skip-db-update --no-progress --image-src remote --scanners vuln --pkg-types os,library --list-all-pkgs --format json --output image-security/production-baseline/keycloak-postgres-prod.json 'docker.io/bitnamilegacy/postgresql@sha256:9d75ed4556cedefaff8f3aa2ccd39093dcf3f7968d013a82f175bff25c2761e4'
              cp .image-audit-cache/db/metadata.json image-security/production-baseline/database-metadata.json
              for item in keycloak-prod keycloak-candidate postgres-prod postgres-candidate keycloak-postgres-prod; do
                test -s "image-security/production-baseline/$item.json"
              done
              echo 'Immutable baseline/candidate scans complete; no image publication or deployment.'
            '''
          }
        }
      }
    }
  }
  post {
    always {
      archiveArtifacts artifacts: 'image-security/production-baseline/**', allowEmptyArchive: true
    }
  }
}
