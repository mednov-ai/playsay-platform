pipeline {
  agent {
    kubernetes {
      yaml """
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins
  securityContext:
    fsGroup: 1000
    fsGroupChangePolicy: OnRootMismatch
  containers:
    - name: gradle
      image: gradle:8-jdk21
      command: ["cat"]
      tty: true
      volumeMounts:
        - name: jenkins-agent-cache
          mountPath: /home/gradle/.gradle
          subPath: gradle-keyboard-backend
      resources:
        requests:
          cpu: 350m
          memory: 768Mi
        limits:
          cpu: "2"
          memory: 2Gi
    - name: liquibase
      image: liquibase/liquibase:5.0.3
      command: ["cat"]
      tty: true
      securityContext:
        runAsUser: 1000
        runAsGroup: 0
      env:
        - name: PLAYSAY_KEYBOARD_DB_JDBC_URL
          valueFrom:
            secretKeyRef:
              name: playsay-keyboard-db
              key: jdbc-uri
        - name: PLAYSAY_KEYBOARD_DB_USERNAME
          valueFrom:
            secretKeyRef:
              name: playsay-keyboard-db
              key: username
        - name: PLAYSAY_KEYBOARD_DB_PASSWORD
          valueFrom:
            secretKeyRef:
              name: playsay-keyboard-db
              key: password
      resources:
        requests:
          cpu: 100m
          memory: 128Mi
        limits:
          cpu: 500m
          memory: 512Mi
    - name: kaniko
      image: gcr.io/kaniko-project/executor:debug
      command: ["/busybox/cat"]
      tty: true
      volumeMounts:
        - name: kaniko-docker-config
          mountPath: /kaniko/.docker
      resources:
        requests:
          cpu: 150m
          memory: 256Mi
        limits:
          cpu: "1"
          memory: 1024Mi
    - name: tools
      image: alpine:3.20
      command: ["cat"]
      tty: true
  volumes:
    - name: kaniko-docker-config
      emptyDir: {}
    - name: jenkins-agent-cache
      persistentVolumeClaim:
        claimName: jenkins-agent-cache
"""
    }
  }

  options {
    buildDiscarder(logRotator(numToKeepStr: '20'))
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
    timestamps()
  }

  parameters {
    string(name: 'BRANCH_NAME', defaultValue: 'develop', description: 'Git branch to build and deploy to dev', trim: true)
    string(name: 'GITHUB_BEFORE', defaultValue: '', description: 'GitHub push before SHA for dispatcher traceability.', trim: true)
    string(name: 'GITHUB_AFTER', defaultValue: '', description: 'GitHub push after SHA to build exactly, when dispatched from webhook.', trim: true)
    string(name: 'ARGOCD_REFRESH_MODE', defaultValue: 'webhook', description: 'ArgoCD refresh mode: webhook or annotate.', trim: true)
  }

  environment {
    GITHUB_OWNER = 'mednov-ai'
    KEYBOARD_SERVICE_IMAGE_NAME = 'playsay-keyboard-service'
    PLATFORM_REPO = 'https://github.com/mednov-ai/playsay-platform.git'
    INFRA_REPO = 'https://github.com/mednov-ai/playsay-infra.git'
    INFRA_BRANCH = 'develop'
  }

  stages {
    stage('Checkout') {
      steps {
        script {
          def requestedBranch = params.BRANCH_NAME?.trim() ?: 'develop'
          def requestedCommit = params.GITHUB_AFTER?.trim()
          def scmVars = checkout([
            $class: 'GitSCM',
            branches: [[name: "*/${requestedBranch}"]],
            doGenerateSubmoduleConfigurations: false,
            extensions: [],
            submoduleCfg: [],
            userRemoteConfigs: [[url: env.PLATFORM_REPO]]
          ])
          if (requestedCommit) {
            sh "git fetch --no-tags origin +refs/heads/${requestedBranch}:refs/remotes/origin/${requestedBranch}"
            sh "git checkout --detach ${requestedCommit}"
          }
          env.GIT_COMMIT = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
          env.GIT_COMMIT_SHORT = env.GIT_COMMIT.take(12)
          env.CI_BRANCH = requestedBranch.replaceFirst(/^origin\//, '').replaceFirst(/^\*\//, '')

          def buildPrefix = env.CI_BRANCH == 'develop' ? 'key-backend-dev' : "key-backend-${env.CI_BRANCH}"
          buildPrefix = buildPrefix.replaceAll(/[^A-Za-z0-9_.-]/, '-')
          buildPrefix = buildPrefix.replaceAll(/^[^A-Za-z0-9]+/, '').replaceAll(/[^A-Za-z0-9]+$/, '')
          int maxPrefixLength = 63 - env.BUILD_NUMBER.length() - 1
          if (buildPrefix.length() > maxPrefixLength) {
            buildPrefix = buildPrefix.take(maxPrefixLength).replaceAll(/[^A-Za-z0-9]+$/, '')
          }
          env.BUILD_LABEL_PREFIX = buildPrefix ?: 'key-backend'
          env.BUILD_LABEL = "${env.BUILD_LABEL_PREFIX}-${env.BUILD_NUMBER}"
          env.DEPLOY_TO_DEV = (
            env.CI_BRANCH == 'develop' ||
            env.CI_BRANCH.startsWith('codex/') ||
            env.CI_BRANCH.startsWith('feature/') ||
            env.CI_BRANCH.startsWith('release/') ||
            env.CI_BRANCH.startsWith('hotfix/')
          ).toString()

          currentBuild.displayName = env.BUILD_LABEL
          currentBuild.description = "${env.CI_BRANCH} @ ${env.GIT_COMMIT_SHORT}"
        }
      }
    }

    stage('Test and package') {
      steps {
        container('gradle') {
          dir('backend') {
            sh 'gradle :keyboard-service:test :keyboard-service:bootJar --no-daemon --stacktrace --max-workers=2 -Dkotlin.compiler.execution.strategy=in-process'
          }
        }
      }
    }

    stage('DB migrate') {
      when {
        expression { env.DEPLOY_TO_DEV == 'true' }
      }
      steps {
        container('liquibase') {
          sh '''
            set -eu
            POSTGRES_JDBC_VERSION="42.7.8"
            POSTGRES_JDBC_JAR="/tmp/postgresql-${POSTGRES_JDBC_VERSION}.jar"
            if [ ! -f "$POSTGRES_JDBC_JAR" ]; then
              curl -fsSL "https://repo1.maven.org/maven2/org/postgresql/postgresql/${POSTGRES_JDBC_VERSION}/postgresql-${POSTGRES_JDBC_VERSION}.jar" -o "$POSTGRES_JDBC_JAR"
            fi
            CHANGELOG="backend/keyboard-service/src/main/resources/db/changelog/db.changelog-master.xml"
            STATUS_LOG="/tmp/keyboard-liquibase-status.log"
            for attempt in $(seq 1 18); do
              if liquibase \
                --changelog-file="$CHANGELOG" \
                --classpath="$POSTGRES_JDBC_JAR" \
                --url="$PLAYSAY_KEYBOARD_DB_JDBC_URL" \
                --username="$PLAYSAY_KEYBOARD_DB_USERNAME" \
                --password="$PLAYSAY_KEYBOARD_DB_PASSWORD" \
                status --verbose > "$STATUS_LOG" 2>&1; then
                cat "$STATUS_LOG"
                break
              fi

              if [ "$attempt" -eq 18 ]; then
                cat "$STATUS_LOG"
                exit 1
              fi

              if grep -Eiq 'Connection could not be created|password authentication failed|connection refused|timeout|does not exist' "$STATUS_LOG"; then
                echo "Waiting for keyboard database credentials to be ready ($attempt/18)"
                sleep 10
              else
                cat "$STATUS_LOG"
                exit 1
              fi
            done
            liquibase \
              --changelog-file="$CHANGELOG" \
              --classpath="$POSTGRES_JDBC_JAR" \
              --url="$PLAYSAY_KEYBOARD_DB_JDBC_URL" \
              --username="$PLAYSAY_KEYBOARD_DB_USERNAME" \
              --password="$PLAYSAY_KEYBOARD_DB_PASSWORD" \
              update
          '''
        }
      }
    }

    stage('Build and push image') {
      when {
        expression { env.DEPLOY_TO_DEV == 'true' }
      }
      steps {
        container('kaniko') {
          withCredentials([usernamePassword(credentialsId: 'github-ghcr', usernameVariable: 'GHCR_USER', passwordVariable: 'GHCR_TOKEN')]) {
            sh '''
              set -eu
              JAR_COUNT="$(find "$WORKSPACE/backend/keyboard-service/build/libs" -maxdepth 1 -name "*.jar" | wc -l | tr -d " ")"
              if [ "$JAR_COUNT" != "1" ]; then
                echo "Expected exactly one keyboard-service bootJar, found $JAR_COUNT"
                find "$WORKSPACE/backend/keyboard-service/build/libs" -maxdepth 1 -type f -print || true
                exit 1
              fi
              for INCLUDE in '!keyboard-service/build/' '!keyboard-service/build/libs/' '!keyboard-service/build/libs/*.jar'; do
                if ! grep -Fxq "$INCLUDE" "$WORKSPACE/backend/.dockerignore"; then
                  echo "keyboard-service bootJar is not included in the backend Docker context: missing $INCLUDE"
                  exit 1
                fi
              done
              mkdir -p /kaniko/.docker
              AUTH="$(printf "%s:%s" "$GHCR_USER" "$GHCR_TOKEN" | base64 | tr -d '\\n')"
              cat > /kaniko/.docker/config.json <<EOF
{"auths":{"ghcr.io":{"auth":"$AUTH"}}}
EOF
              /kaniko/executor \
                --context "$WORKSPACE/backend" \
                --dockerfile "$WORKSPACE/backend/keyboard-service/Dockerfile" \
                --destination "ghcr.io/${GITHUB_OWNER}/${KEYBOARD_SERVICE_IMAGE_NAME}:${GIT_COMMIT}" \
                --destination "ghcr.io/${GITHUB_OWNER}/${KEYBOARD_SERVICE_IMAGE_NAME}:${BUILD_LABEL}" \
                --destination "ghcr.io/${GITHUB_OWNER}/${KEYBOARD_SERVICE_IMAGE_NAME}:dev"
            '''
          }
        }
      }
    }

    stage('Tag source commit') {
      when {
        expression { env.DEPLOY_TO_DEV == 'true' }
      }
      steps {
        container('tools') {
          withCredentials([usernamePassword(credentialsId: 'github-infra-token', usernameVariable: 'GITHUB_USER', passwordVariable: 'GITHUB_TOKEN')]) {
            sh 'apk add --no-cache git && ./scripts/ci/tag-source-commit.sh'
          }
        }
      }
    }

    stage('Update dev image tag') {
      when {
        expression { env.DEPLOY_TO_DEV == 'true' }
      }
      steps {
        container('tools') {
          withCredentials([usernamePassword(credentialsId: 'github-infra-token', usernameVariable: 'GITHUB_USER', passwordVariable: 'GITHUB_TOKEN')]) {
            sh 'apk add --no-cache git yq && CHART_VALUES_FILE=helm-charts/keyboard-service/values-dev.yaml ./scripts/ci/update-dev-image-tag.sh'
          }
        }
      }
    }

    stage('Wait for rollout') {
      when {
        expression { env.DEPLOY_TO_DEV == 'true' }
      }
      steps {
        container('tools') {
          sh 'apk add --no-cache jq kubectl && APP=keyboard-service ./scripts/ci/wait-for-argocd-rollout.sh'
        }
      }
    }
  }

  post {
    always {
      echo "Build ${env.BUILD_LABEL ?: env.BUILD_NUMBER} finished with ${currentBuild.currentResult}"
    }
  }
}
