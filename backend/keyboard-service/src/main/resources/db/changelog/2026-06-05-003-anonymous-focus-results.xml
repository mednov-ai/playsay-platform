    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-06-05-003-create-keyboard-anonymous-profiles" author="codex">
        <createTable tableName="keyboard_anonymous_profiles">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_keyboard_anonymous_profiles"/>
            </column>
            <column name="device_id" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="fingerprint_hash" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="display_name" type="VARCHAR(64)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_seen_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint
            tableName="keyboard_anonymous_profiles"
            columnNames="device_id"
            constraintName="uk_keyboard_anonymous_profiles_device_id"/>
    </changeSet>

    <changeSet id="2026-06-05-003-extend-keyboard-training-results" author="codex">
        <dropNotNullConstraint
            tableName="keyboard_training_results"
            columnName="keycloak_subject"
            columnDataType="VARCHAR(255)"/>
        <addColumn tableName="keyboard_training_results">
            <column name="anonymous_profile_id" type="BIGINT"/>
            <column name="lesson_kind" type="VARCHAR(16)" defaultValue="STANDARD">
                <constraints nullable="false"/>
            </column>
            <column name="per_char" type="VARCHAR(2048)" defaultValue="{}">
                <constraints nullable="false"/>
            </column>
            <column name="per_chord" type="VARCHAR(2048)" defaultValue="{}">
                <constraints nullable="false"/>
            </column>
            <column name="focus_problem_keys" type="VARCHAR(1024)" defaultValue="[]">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addForeignKeyConstraint
            baseTableName="keyboard_training_results"
            baseColumnNames="anonymous_profile_id"
            constraintName="fk_keyboard_training_results_anonymous_profile"
            referencedTableName="keyboard_anonymous_profiles"
            referencedColumnNames="id"
            onDelete="CASCADE"/>
        <createIndex tableName="keyboard_training_results" indexName="idx_keyboard_training_results_anonymous_created">
            <column name="anonymous_profile_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

