<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-06-11-004-extend-keyboard-gamification-calibration" author="codex">
        <addColumn tableName="keyboard_gamification_profiles">
            <column name="calibration_session_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="calibration_mastery_total" type="DOUBLE" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="calibration_completed_at" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>
    </changeSet>

    <changeSet id="2026-06-11-005-create-keyboard-technique-advice-cache" author="codex">
        <createTable tableName="keyboard_technique_advice_cache">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_keyboard_technique_advice_cache"/>
            </column>
            <column name="fingerprint" type="VARCHAR(512)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_keyboard_technique_advice_cache_fingerprint"/>
            </column>
            <column name="training_result_id" type="BIGINT"/>
            <column name="source" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="primary_advice" type="VARCHAR(320)">
                <constraints nullable="false"/>
            </column>
            <column name="drill_suggestion" type="VARCHAR(240)">
                <constraints nullable="false"/>
            </column>
            <column name="tone" type="VARCHAR(24)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="keyboard_technique_advice_cache" indexName="idx_keyboard_technique_advice_cache_result">
            <column name="training_result_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
