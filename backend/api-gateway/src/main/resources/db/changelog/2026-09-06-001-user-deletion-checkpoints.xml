<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <changeSet id="2026-09-06-001-user-deletion-checkpoints" author="playsay">
        <addColumn tableName="user_deletion_operation">
            <column name="stage" type="VARCHAR(32)" defaultValue="LEGACY"><constraints nullable="false"/></column>
        </addColumn>
        <createIndex tableName="user_deletion_operation" indexName="idx_user_deletion_recovery">
            <column name="status"/><column name="updated_at"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="user_deletion_operation" indexName="idx_user_deletion_recovery"/>
            <dropColumn tableName="user_deletion_operation" columnName="stage"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
