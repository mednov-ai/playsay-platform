<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-08-26-002-cascade-lesson-access" author="codex">
        <dropForeignKeyConstraint baseTableName="lesson_email_challenge" constraintName="fk_lesson_email_challenge_attempt"/>
        <addForeignKeyConstraint
            baseTableName="lesson_email_challenge"
            baseColumnNames="attempt_id"
            referencedTableName="lesson_entry_attempt"
            referencedColumnNames="id"
            constraintName="fk_lesson_email_challenge_attempt"
            onDelete="CASCADE"/>

        <dropForeignKeyConstraint baseTableName="lesson_entry_attempt" constraintName="fk_lesson_entry_attempt_lesson"/>
        <addForeignKeyConstraint
            baseTableName="lesson_entry_attempt"
            baseColumnNames="lesson_id"
            referencedTableName="lesson"
            referencedColumnNames="id"
            constraintName="fk_lesson_entry_attempt_lesson"
            onDelete="CASCADE"/>

        <dropForeignKeyConstraint baseTableName="lesson_admission" constraintName="fk_lesson_admission_lesson"/>
        <addForeignKeyConstraint
            baseTableName="lesson_admission"
            baseColumnNames="lesson_id"
            referencedTableName="lesson"
            referencedColumnNames="id"
            constraintName="fk_lesson_admission_lesson"
            onDelete="CASCADE"/>

        <dropForeignKeyConstraint baseTableName="lesson_access_link" constraintName="fk_lesson_access_link_lesson"/>
        <addForeignKeyConstraint
            baseTableName="lesson_access_link"
            baseColumnNames="lesson_id"
            referencedTableName="lesson"
            referencedColumnNames="id"
            constraintName="fk_lesson_access_link_lesson"
            onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>
