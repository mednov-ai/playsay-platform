pipeline {
  agent none

  options {
    buildDiscarder(logRotator(numToKeepStr: '30'))
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
    timestamps()
    timeout(time: 360, unit: 'MINUTES')
  }

  parameters {
    string(name: 'BRANCH_NAME', defaultValue: 'develop', description: 'Git branch received from GitHub push event.', trim: true)
    string(name: 'GITHUB_BEFORE', defaultValue: '', description: 'GitHub push before SHA.', trim: true)
    string(name: 'GITHUB_AFTER', defaultValue: '', description: 'GitHub push after SHA.', trim: true)
    string(name: 'FORCE_TARGETS', defaultValue: '', description: 'Optional manual override: all or comma-separated deploy targets.', trim: true)
    string(name: 'MAX_PARALLEL_MODULE_JOBS', defaultValue: '1', description: 'Single-node dev capacity is fixed to one downstream module job.', trim: true)
  }

  environment {
    PLATFORM_REPO = 'https://github.com/mednov-ai/playsay-platform.git'
  }

  stages {
    stage('Analyze changes') {
      agent {
        kubernetes {
          yaml """
apiVersion: v1
kind: Pod
spec:
  activeDeadlineSeconds: 600
  serviceAccountName: jenkins
  containers:
    - name: jnlp
      image: jenkins/inbound-agent:3383.vc8881d4b_0e76-1-jdk25
      resources:
        requests:
          cpu: 50m
          memory: 128Mi
        limits:
          cpu: 300m
          memory: 384Mi
    - name: node
      image: node:22
      command: ["cat"]
      tty: true
      resources:
        requests:
          cpu: 50m
          memory: 128Mi
        limits:
          cpu: 300m
          memory: 384Mi
"""
        }
      }
      steps {
        script {
          def requestedBranch = params.BRANCH_NAME?.trim() ?: 'develop'
          def requestedCommit = params.GITHUB_AFTER?.trim()
          checkout([
            $class: 'GitSCM',
            branches: [[name: "*/${requestedBranch}"]],
            doGenerateSubmoduleConfigurations: false,
            extensions: [],
            submoduleCfg: [],
            userRemoteConfigs: [[url: env.PLATFORM_REPO]]
          ])
          if (requestedCommit) {
            sh "git fetch --no-tags origin +refs/heads/${requestedBranch}:refs/remotes/origin/${requestedBranch}"
            sh "git checkout --detach ${requestedCommit}"
          }
          env.CI_BRANCH = requestedBranch.replaceFirst(/^origin\//, '').replaceFirst(/^\*\//, '')
          env.GIT_COMMIT = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
          env.GIT_COMMIT_SHORT = env.GIT_COMMIT.take(12)
          currentBuild.displayName = "dispatch-${env.BUILD_NUMBER}"
          currentBuild.description = "${env.CI_BRANCH} @ ${env.GIT_COMMIT_SHORT}"
        }

        container('node') {
          sh '''
            set -eu
            if ! command -v git >/dev/null 2>&1; then
              apt-get update
              apt-get install -y --no-install-recommends git ca-certificates
            fi
            git config --global --add safe.directory "$WORKSPACE"
            GITHUB_BEFORE="${GITHUB_BEFORE:-}" \
            GITHUB_AFTER="${GITHUB_AFTER:-}" \
            FORCE_TARGETS="${FORCE_TARGETS:-}" \
              node scripts/ci/detect-affected-targets.mjs --env > affected-targets.env
            cat affected-targets.env
          '''
        }

        script {
          def detection = [:]
          readFile('affected-targets.env').split('\\n').each { line ->
            def separator = line.indexOf('=')
            if (separator >= 0) {
              detection[line.substring(0, separator)] = line.substring(separator + 1).trim()
            }
          }
          env.AFFECTED_JOBS = detection.AFFECTED_JOBS ?: ''
          env.AFFECTED_TARGETS = detection.AFFECTED_TARGETS ?: ''
          env.AFFECTED_REASON = detection.AFFECTED_REASON ?: 'unknown'
          echo "Dispatcher source branch: ${env.CI_BRANCH}"
          echo "Dispatcher source commit: ${env.GIT_COMMIT}"
          echo "Affected targets: ${env.AFFECTED_TARGETS ?: '(none)'}"
          echo "Detection reason: ${env.AFFECTED_REASON}"
        }
      }
    }

    stage('Dispatch downstream jobs') {
      steps {
        script {
          if ((params.MAX_PARALLEL_MODULE_JOBS?.trim() ?: '1') != '1') {
            error 'MAX_PARALLEL_MODULE_JOBS is fixed to 1 on the single-node dev cluster.'
          }
          def jobs = (env.AFFECTED_JOBS ?: '').split(',').collect { it.trim() }.findAll { it }
          if (jobs.isEmpty()) {
            echo 'No downstream jobs needed for this change.'
            return
          }

          def downstreamResults = []
          jobs.eachWithIndex { jobName, index ->
            def downstreamParams = [
              string(name: 'BRANCH_NAME', value: env.CI_BRANCH),
              string(name: 'GITHUB_BEFORE', value: params.GITHUB_BEFORE?.trim() ?: ''),
              string(name: 'GITHUB_AFTER', value: env.GIT_COMMIT)
            ]
            echo "Triggering ${jobName} (${index + 1}/${jobs.size()})"
            try {
              def downstreamBuild = build job: jobName, parameters: downstreamParams, wait: true, propagate: false
              downstreamResults << [
                job: jobName,
                result: downstreamBuild?.result ?: 'UNKNOWN',
                number: downstreamBuild?.number ?: '',
                url: downstreamBuild?.absoluteUrl ?: ''
              ]
            } catch (err) {
              downstreamResults << [job: jobName, result: 'FAILURE', number: '', url: '', error: err.toString()]
            }
          }

          def resultSummary = downstreamResults.collect { result ->
            def buildRef = result.number ? " #${result.number}" : ''
            "${result.job}=${result.result}${buildRef}"
          }.join(', ')
          echo "Downstream module job results: ${resultSummary}"

          def failures = downstreamResults.findAll { it.result != 'SUCCESS' }
          if (!failures.isEmpty()) {
            error "Downstream module job failures: ${failures.collect { it.job + '=' + it.result }.join(', ')}"
          }
        }
      }
    }
  }

  post {
    always {
      echo "Dispatcher ${env.BUILD_NUMBER} finished with ${currentBuild.currentResult}"
    }
  }
}
