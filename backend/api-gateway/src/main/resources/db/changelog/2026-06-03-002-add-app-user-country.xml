<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-06-03-002-add-app-user-country" author="codex">
        <addColumn tableName="app_user">
            <column name="country_code" type="varchar(2)" defaultValue="RU"/>
        </addColumn>
        <update tableName="app_user">
            <column name="country_code" value="RU"/>
            <where>country_code IS NULL</where>
        </update>
    </changeSet>
</databaseChangeLog>
