{
  "name": "@playsay/browser-extension",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && vite build --config vite.service.config.ts && vite build --config vite.content.config.ts",
    "package": "npm run build && node scripts/package.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.31",
    "@types/node": "^22.10.2",
    "fflate": "^0.8.2",
    "typescript": "^5.8.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.5"
  }
}
