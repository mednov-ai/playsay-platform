<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-11-20-001-image-object-cleanup" author="honey-school">
        <createTable tableName="material_image_object_cleanup">
            <column name="storage_key" type="VARCHAR(1024)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="eligible_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
            <column name="collecting" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="material_image_object_cleanup" indexName="ix_material_image_cleanup_due">
            <column name="eligible_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
