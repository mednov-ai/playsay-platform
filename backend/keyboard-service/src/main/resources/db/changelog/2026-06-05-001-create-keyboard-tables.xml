<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-06-05-001-create-keyboard-chord-sets" author="codex">
        <createTable tableName="keyboard_chord_sets">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_keyboard_chord_sets"/>
            </column>
            <column name="layout" type="VARCHAR(8)">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="difficulty" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="keyboard_chord_sets" indexName="idx_keyboard_chord_sets_layout">
            <column name="layout"/>
        </createIndex>
    </changeSet>

    <changeSet id="2026-06-05-001-create-keyboard-chords" author="codex">
        <createTable tableName="keyboard_chords">
            <column name="chord_set_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="position" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="chord_value" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey
            tableName="keyboard_chords"
            columnNames="chord_set_id, position"
            constraintName="pk_keyboard_chords"/>
        <addForeignKeyConstraint
            baseTableName="keyboard_chords"
            baseColumnNames="chord_set_id"
            constraintName="fk_keyboard_chords_chord_set"
            referencedTableName="keyboard_chord_sets"
            referencedColumnNames="id"
            onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="2026-06-05-001-create-keyboard-training-results" author="codex">
        <createTable tableName="keyboard_training_results">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_keyboard_training_results"/>
            </column>
            <column name="keycloak_subject" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="chord_set_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="speed_cpm" type="DOUBLE">
                <constraints nullable="false"/>
            </column>
            <column name="accuracy" type="DOUBLE">
                <constraints nullable="false"/>
            </column>
            <column name="errors" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="duration_ms" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="per_finger" type="VARCHAR(2048)" defaultValue="{}">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="keyboard_training_results"
            baseColumnNames="chord_set_id"
            constraintName="fk_keyboard_training_results_chord_set"
            referencedTableName="keyboard_chord_sets"
            referencedColumnNames="id"/>
        <createIndex tableName="keyboard_training_results" indexName="idx_keyboard_training_results_subject_created">
            <column name="keycloak_subject"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
