{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playsay.local/contracts/websocket-messages.schema.json",
  "title": "PlaySayWebSocketMessage",
  "oneOf": [
    {
      "type": "object",
      "required": ["type", "lessonId", "studentId"],
      "properties": {
        "type": { "const": "LESSON_PRESENCE_CHANGED" },
        "lessonId": { "type": "string", "format": "uuid" },
        "studentId": { "type": "string", "format": "uuid" },
        "status": { "enum": ["JOINED", "LEFT"] }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message"],
      "properties": {
        "type": { "const": "chat.message.created" },
        "message": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "conversationId", "senderSubject", "clientMessageId", "text", "createdAt"],
          "properties": {
            "id": { "type": "string", "format": "uuid" },
            "conversationId": { "type": "string", "format": "uuid" },
            "senderSubject": { "type": "string" },
            "clientMessageId": { "type": "string", "format": "uuid" },
            "text": { "type": "string", "maxLength": 4000 },
            "createdAt": { "type": "string", "format": "date-time" },
            "deliveredAt": { "type": ["string", "null"], "format": "date-time" },
            "readAt": { "type": ["string", "null"], "format": "date-time" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "delivery"],
      "properties": {
        "type": { "const": "chat.messages.delivered" },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["conversationId", "recipientSubject", "messageIds", "deliveredAt"],
          "properties": {
            "conversationId": { "type": "string", "format": "uuid" },
            "recipientSubject": { "type": "string" },
            "messageIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "format": "uuid" }
            },
            "deliveredAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "receipt"],
      "properties": {
        "type": { "const": "chat.conversation.read" },
        "receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["conversationId", "readerSubject", "lastReadMessageId", "readAt"],
          "properties": {
            "conversationId": { "type": "string", "format": "uuid" },
            "readerSubject": { "type": "string" },
            "lastReadMessageId": { "type": "string", "format": "uuid" },
            "readAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ownerSubject"],
      "properties": {
        "type": { "const": "vocabulary.subscribe" },
        "ownerSubject": { "type": "string", "minLength": 1, "maxLength": 255 },
        "lessonId": { "type": ["string", "null"], "format": "uuid" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "practiceId"],
      "properties": {
        "type": { "const": "vocabulary.practice.subscribe" },
        "practiceId": { "type": "string", "format": "uuid" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "connected" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ownerSubject"],
      "properties": {
        "type": { "const": "vocabulary.subscribed" },
        "ownerSubject": { "type": "string", "minLength": 1, "maxLength": 255 },
        "lessonId": { "type": ["string", "null"], "format": "uuid" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "practiceId"],
      "properties": {
        "type": { "const": "vocabulary.practice.subscribed" },
        "practiceId": { "type": "string", "format": "uuid" },
        "lessonId": { "type": ["string", "null"], "format": "uuid" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ownerSubject", "actorSubject", "entry"],
      "properties": {
        "type": {
          "enum": [
            "vocabulary.entry.created",
            "vocabulary.entry.updated",
            "vocabulary.entry.archived"
          ]
        },
        "ownerSubject": { "type": "string", "minLength": 1, "maxLength": 255 },
        "lessonId": { "type": ["string", "null"], "format": "uuid" },
        "actorSubject": { "type": "string", "minLength": 1, "maxLength": 255 },
        "entry": { "$ref": "#/$defs/vocabularyEntry" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "practiceId", "actorSubject", "practice"],
      "properties": {
        "type": {
          "enum": [
            "vocabulary.practice.started",
            "vocabulary.practice.paused",
            "vocabulary.practice.completed",
            "vocabulary.session.updated",
            "vocabulary.attempt.recorded"
          ]
        },
        "practiceId": { "type": "string", "format": "uuid" },
        "lessonId": { "type": ["string", "null"], "format": "uuid" },
        "sessionId": { "type": ["string", "null"], "format": "uuid" },
        "actorSubject": { "type": "string", "minLength": 1, "maxLength": 255 },
        "practice": { "$ref": "#/$defs/vocabularyPractice" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message"],
      "properties": {
        "type": { "const": "error" },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  ],
  "$defs": {
    "vocabularyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceText",
        "sourceLanguage",
        "targetLanguage",
        "translationState",
        "status",
        "practicePaused",
        "occurrences",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "sourceText": { "type": "string", "maxLength": 240 },
        "sourceLanguage": { "type": "string", "maxLength": 16 },
        "targetLanguage": { "type": "string", "maxLength": 16 },
        "translation": { "type": ["string", "null"], "maxLength": 500 },
        "partOfSpeech": { "type": ["string", "null"], "maxLength": 80 },
        "example": { "type": ["string", "null"], "maxLength": 1000 },
        "exampleTranslation": { "type": ["string", "null"], "maxLength": 1000 },
        "translationState": { "enum": ["MISSING", "SUGGESTED", "CONFIRMED"] },
        "status": { "enum": ["ACTIVE", "ARCHIVED"] },
        "practicePaused": { "type": "boolean" },
        "occurrences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceType", "createdAt"],
            "properties": {
              "sourceType": { "enum": ["LESSON", "HOMEWORK", "MANUAL"] },
              "lessonId": { "type": ["string", "null"], "format": "uuid" },
              "assignmentId": { "type": ["string", "null"], "format": "uuid" },
              "materialId": { "type": ["string", "null"], "format": "uuid" },
              "blockId": { "type": ["string", "null"], "maxLength": 120 },
              "context": { "type": ["string", "null"], "maxLength": 1000 },
              "createdAt": { "type": "string", "format": "date-time" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "vocabularyPractice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "delivery", "mode", "status", "sessions", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "delivery": { "enum": ["SELF", "HOMEWORK", "LIVE"] },
        "mode": { "enum": ["QUICK", "BALANCED", "WRITING", "KEYBOARD"] },
        "status": { "enum": ["PREPARING", "PUBLISHED", "ACTIVE", "PAUSED", "COMPLETED", "CANCELLED", "FAILED"] },
        "lessonId": { "type": ["string", "null"], "format": "uuid" },
        "assignmentId": { "type": ["string", "null"], "format": "uuid" },
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "ownerSubject", "status", "revision", "completedItems", "totalItems", "correctCount", "attemptCount", "helpRequested", "updatedAt"],
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "ownerSubject": { "type": "string", "maxLength": 255 },
              "ownerName": { "type": ["string", "null"] },
              "status": { "enum": ["NOT_STARTED", "IN_PROGRESS", "PAUSED", "COMPLETED", "CANCELLED"] },
              "revision": { "type": "integer", "minimum": 0 },
              "completedItems": { "type": "integer", "minimum": 0 },
              "totalItems": { "type": "integer", "minimum": 0 },
              "correctCount": { "type": "integer", "minimum": 0 },
              "attemptCount": { "type": "integer", "minimum": 0 },
              "accuracy": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "currentItem": { "type": ["object", "null"] },
              "teacherHint": { "type": ["string", "null"] },
              "helpRequested": { "type": "boolean" },
              "startedAt": { "type": ["string", "null"], "format": "date-time" },
              "completedAt": { "type": ["string", "null"], "format": "date-time" },
              "updatedAt": { "type": "string", "format": "date-time" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
